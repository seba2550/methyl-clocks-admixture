	author = {Snitz, Beth E. and Chang, Yuefang and Tudorascu, Dana L. and Lopez, Oscar L. and Lopresti, Brian J. and DeKosky, Steven T. and Carlson, Michelle C. and Cohen, Ann D. and Kamboh, M. Ilyas and Aizenstein, Howard J. and Klunk, William E. and Kuller, Lewis H.},
	month = aug,
