@article{cao_retinoid_2004,
	title = {Retinoid {X} {Receptor} {Regulates} {Nur77}/{Thyroid} {Hormone} {Receptor} 3-{Dependent} {Apoptosis} by {Modulating} {Its} {Nuclear} {Export} and {Mitochondrial} {Targeting}},
