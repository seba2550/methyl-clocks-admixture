	doi = {10.1101/2022.11.08.515616},
	file = {Submitted Version:/Users/sgonzalez/Zotero/storage/HC9BSWSK/Jens et al. - 2022 - RBPamp Quantitative Modeling of Protein-RNA Inter.pdf:application/pdf},
}

@article{van_nostrand_large-scale_2020,
	title = {A large-scale binding and functional map of human {RNA}-binding proteins},
	volume = {583},
	issn = {0028-0836, 1476-4687},
