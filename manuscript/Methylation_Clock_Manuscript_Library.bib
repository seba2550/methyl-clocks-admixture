	author = {Park, Byung-Jae and Lee, Duk-Gyu and Yu, Jae-Ran and Jung, Sun-ki and Choi, Kyuyeong and Lee, Jungsoo and Lee, Jiyeon and Kim, Yun Sik and Lee, Jin Il and Kwon, Jae Young and Lee, Junho and Singson, Andrew and Song, Woo Keun and Eom, Soo Hyun and Park, Chul-Seung and Kim, Do Han and Bandyopadhyay, Jaya and Ahnn, Joohong},
