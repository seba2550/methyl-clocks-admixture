Publisher: Nature Publishing Group},
	keywords = {Epigenetics, Machine learning, Epigenomics, Genomic analysis, Statistical methods},
	pages = {369--383},
	file = {Full Text PDF:/Users/sgonzalez/Zotero/storage/P8ZQ3BCJ/Yousefi et al. - 2022 - DNA methylation-based predictors of health applic.pdf:application/pdf},
}

