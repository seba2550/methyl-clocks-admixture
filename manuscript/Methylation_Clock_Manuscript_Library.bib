	number = {1},
	urldate = {2024-08-17},
	journal = {Genome Biology},
	author = {Villicaña, Sergio and Castillo-Fernandez, Juan and Hannon, Eilis and Christiansen, Colette and Tsai, Pei-Chien and Maddock, Jane and Kuh, Diana and Suderman, Matthew and Power, Christine and Relton, Caroline and Ploubidis, George and Wong, Andrew and Hardy, Rebecca and Goodman, Alissa and Ong, Ken K. and Bell, Jordana T.},
	month = jul,
	year = {2023},
	pages = {176},
	file = {Full Text:/Users/sgonzalez/Zotero/storage/AA8HZ96M/Villicaña et al. - 2023 - Genetic impacts on DNA methylation help elucidate .pdf:application/pdf},
}

